    <!-- http://purl.obolibrary.org/obo/MF_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000017">
        <rdfs:label xml:lang="en">consciousness</rdfs:label>
        <obo:IAO_0000115>Consciousness is an inseparable part of all mental processes. It is that part of the mental process that:
a) confers a subjective perspective, a phenomenology, an experience of the mental process of which it is a part; and
b) intends the object or event that the mental process is about, should such exist; i.e., it confers intentionality on the mental process.</obo:IAO_0000115>
        <obo:IAO_0000111 xml:lang="en">consciousness</obo:IAO_0000111>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mf.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000030">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">representation</rdfs:label>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">representation</obo:IAO_0000111>
        <obo:IAO_0000115>A dependent continuant which is about a portion of reality.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mf.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000073">
        <rdfs:label xml:lang="en">intentionality</rdfs:label>
        <obo:IAO_0000115>Intentionality is the fundamental quality of conscious mental processes of always having content, of being directed towards, or about something.</obo:IAO_0000115>
        <obo:IAO_0000111 xml:lang="en">intentionality</obo:IAO_0000111>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mf.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000074 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000074">
        <rdfs:label xml:lang="en">bodily quality</rdfs:label>
        <obo:IAO_0000115>A bodily quality is a quality that inheres in some extended organism.</obo:IAO_0000115>
        <obo:IAO_0000111 xml:lang="en">bodily quality</obo:IAO_0000111>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mf.owl"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MF_0000075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MF_0000075">
        <rdfs:label xml:lang="en">mental quality</rdfs:label>
        <obo:IAO_0000115>A mental quality is a bodily quality that inheres in those structures of the extended organism that are essential for mental functioning.</obo:IAO_0000115>
        <obo:IAO_0000111 xml:lang="en">mental quality</obo:IAO_0000111>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mf.owl"/>
    </owl:Class>
</rdf:RDF>



